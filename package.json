{
  "name": "@prevalentware/opencode-goal-plugin",
  "version": "0.1.2",
  "description": "Goal-mode plugin for OpenCode (self-contained build). The goal-state popup and the input-box status icon are opt-out: goalPopup / goalStatusIcon. TUI-only popup: github:ggrabarz/opencode-goal-state-popup",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server": {
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./tui": {
      "import": "./src/tui.ts",
      "default": "./src/tui.ts"
    }
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src/tui.ts",
    "src/i18n.ts",
    "src/state-path.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "opencode": ">=1.17.1"
  },
  "license": "MIT"
}
